# ============================================================
# .env.example — TEMPLATE ONLY
# ------------------------------------------------------------
# 1. Copy this file:           cp .env.example .env
# 2. Fill in real values in .env
# 3. .env is gitignored — NEVER commit real secrets
# 4. When adding a new secret, add the KEY (not the value)
#    to this file so others know it exists.
# ============================================================

# ----- OpenAI ------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=

# ----- Anthropic ---------------------------------------------
ANTHROPIC_API_KEY=

# ----- Google (Gemini / DeepMind) ----------------------------
GOOGLE_API_KEY=

# ----- Ollama (local default; no key needed) -----------------
OLLAMA_BASE_URL=http://localhost:11434

# ----- LiteLLM Gateway (optional unified entrypoint) ---------
LITELLM_BASE_URL=
LITELLM_API_KEY=

# ----- Remote execution servers ------------------------------
# Never put credentials in URLs; use the separate token vars.
REMOTE_GPU_HOST=
REMOTE_GPU_PORT=
REMOTE_GPU_TOKEN=
SPARK_MASTER_URL=

# ----- App settings ------------------------------------------
# Which provider's default endpoint is selected first on app load.
DEFAULT_PROVIDER=ollama

# Fallback default model for all providers that don't have one of their own below.
DEFAULT_MODEL=llama3.1

# Per-provider default models (override DEFAULT_MODEL above).
# Each one is the model string passed to that provider's API directly.
OLLAMA_DEFAULT_MODEL=
OPENAI_DEFAULT_MODEL=
ANTHROPIC_DEFAULT_MODEL=
LITELLM_DEFAULT_MODEL=
